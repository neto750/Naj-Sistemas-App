<?xml version="1.0" encoding="utf-8" ?>
<ContentPage x:Class="NajGravador.Views.NewContactPage" xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" BackgroundColor="#F7F9FC" Shell.NavBarIsVisible="False">
    <Grid RowDefinitions="Auto,*">
        <Border Padding="12,10" BackgroundColor="White" Stroke="#E2E7ED"><Grid ColumnDefinitions="44,*"><Button Text="‹" FontSize="30" TextColor="#1E3A5F" BackgroundColor="Transparent" Padding="0" Clicked="OnBackClicked"/><Label Grid.Column="1" Text="Novo contato" FontSize="19" FontAttributes="Bold" TextColor="#1E3A5F" VerticalTextAlignment="Center"/></Grid></Border>
        <ScrollView Grid.Row="1"><VerticalStackLayout Padding="22,28" Spacing="16" MaximumWidthRequest="520" HorizontalOptions="Center">
            <Image Source="default_avatar.svg" HeightRequest="74"/>
            <Label Text="O contato precisa ter uma conta cadastrada neste aparelho para o teste local." FontSize="11" TextColor="#6D7B8A" HorizontalTextAlignment="Center"/>
            <VerticalStackLayout Spacing="5"><Label Text="E-mail do usuário" FontSize="12" FontAttributes="Bold" TextColor="#46586A"/><Border Padding="12,2" BackgroundColor="White" Stroke="#D9E1EA"><Border.StrokeShape><RoundRectangle CornerRadius="12"/></Border.StrokeShape><Entry x:Name="EmailEntry" Placeholder="contato@email.com" Keyboard="Email"/></Border></VerticalStackLayout>
            <VerticalStackLayout Spacing="5"><Label Text="Nome" FontSize="12" FontAttributes="Bold" TextColor="#46586A"/><Border Padding="12,2" BackgroundColor="White" Stroke="#D9E1EA"><Border.StrokeShape><RoundRectangle CornerRadius="12"/></Border.StrokeShape><Entry x:Name="FirstNameEntry" Placeholder="Nome salvo"/></Border></VerticalStackLayout>
            <VerticalStackLayout Spacing="5"><Label Text="Sobrenome" FontSize="12" FontAttributes="Bold" TextColor="#46586A"/><Border Padding="12,2" BackgroundColor="White" Stroke="#D9E1EA"><Border.StrokeShape><RoundRectangle CornerRadius="12"/></Border.StrokeShape><Entry x:Name="LastNameEntry" Placeholder="Sobrenome"/></Border></VerticalStackLayout>
            <Label x:Name="ErrorLabel" IsVisible="False" FontSize="12" TextColor="#C62828"/>
            <Button Text="Salvar contato" FontAttributes="Bold" BackgroundColor="#1E66C2" TextColor="White" CornerRadius="12" HeightRequest="48" Clicked="OnSaveClicked"/>
        </VerticalStackLayout></ScrollView>
    </Grid>
</ContentPage>
