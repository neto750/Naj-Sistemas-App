<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="NajGravador.Views.LoginPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    BackgroundColor="#F7F9FC"
    Shell.NavBarIsVisible="False">

    <ScrollView>
        <VerticalStackLayout Padding="28,54" Spacing="18" MaximumWidthRequest="430" HorizontalOptions="Center">
            <Image Source="logo_naj.png" HeightRequest="72" Aspect="AspectFit"/>
            <VerticalStackLayout Spacing="4" Margin="0,10,0,8">
                <Label Text="Bem-vindo" FontSize="28" FontAttributes="Bold" TextColor="#1E3A5F" HorizontalTextAlignment="Center"/>
                <Label Text="Entre para acessar o sistema e o chat interno" FontSize="13" TextColor="#66778A" HorizontalTextAlignment="Center"/>
            </VerticalStackLayout>

            <VerticalStackLayout Spacing="6">
                <Label Text="E-mail" FontSize="12" FontAttributes="Bold" TextColor="#46586A"/>
                <Border Padding="12,2" BackgroundColor="White" Stroke="#D9E1EA">
                    <Border.StrokeShape><RoundRectangle CornerRadius="12"/></Border.StrokeShape>
                    <Entry x:Name="EmailEntry" Placeholder="seu@email.com" Keyboard="Email" ReturnType="Next"/>
                </Border>
            </VerticalStackLayout>

            <VerticalStackLayout Spacing="6">
                <Label Text="Senha" FontSize="12" FontAttributes="Bold" TextColor="#46586A"/>
                <Border Padding="12,2" BackgroundColor="White" Stroke="#D9E1EA">
                    <Border.StrokeShape><RoundRectangle CornerRadius="12"/></Border.StrokeShape>
                    <Entry x:Name="PasswordEntry" Placeholder="Digite sua senha" IsPassword="True" ReturnType="Go" Completed="OnLoginCompleted"/>
                </Border>
            </VerticalStackLayout>

            <Label x:Name="ErrorLabel" IsVisible="False" FontSize="12" TextColor="#C62828" HorizontalTextAlignment="Center"/>

            <Button
                x:Name="LoginButton"
                Text="Entrar"
                FontAttributes="Bold"
                BackgroundColor="#1E66C2"
                TextColor="White"
                CornerRadius="12"
                HeightRequest="50"
                Clicked="OnLoginClicked"/>

            <HorizontalStackLayout HorizontalOptions="Center" Spacing="3">
                <Label Text="Ainda não tem uma conta?" FontSize="13" TextColor="#66778A" VerticalTextAlignment="Center"/>
                <Button Text="Cadastre-se" FontSize="13" FontAttributes="Bold" TextColor="#1E66C2" BackgroundColor="Transparent" Padding="4" Clicked="OnRegisterClicked"/>
            </HorizontalStackLayout>

            <Border Margin="0,16,0,0" Padding="12" BackgroundColor="#EAF3FE" Stroke="Transparent">
                <Border.StrokeShape><RoundRectangle CornerRadius="10"/></Border.StrokeShape>
                <Label Text="Teste local: crie duas contas e alterne entre elas nas Configurações para enviar e receber mensagens neste aparelho." FontSize="11" TextColor="#365B83" HorizontalTextAlignment="Center"/>
            </Border>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
