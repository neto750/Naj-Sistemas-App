<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="NajGravador.Views.ChatConversationPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    BackgroundColor="#EDF2F6"
    Shell.NavBarIsVisible="False">

    <Grid RowDefinitions="Auto,*,Auto">
        <Border Padding="10,8" BackgroundColor="White" Stroke="#DDE4EC">
            <Grid ColumnDefinitions="42,44,*,38" ColumnSpacing="7">
                <Button Text="‹" FontSize="30" TextColor="#1E3A5F" BackgroundColor="Transparent" Padding="0" Clicked="OnBackClicked"/>
                <ContentView x:Name="AvatarHost" Grid.Column="1" WidthRequest="40" HeightRequest="40"/>
                <VerticalStackLayout Grid.Column="2" Spacing="0" VerticalOptions="Center">
                    <Label x:Name="TitleLabel" Text="Conversa" FontSize="16" FontAttributes="Bold" TextColor="#1E3A5F" LineBreakMode="TailTruncation"/>
                    <Label x:Name="SubtitleLabel" Text="Chat interno NAJ" FontSize="10" TextColor="#778594" LineBreakMode="TailTruncation"/>
                </VerticalStackLayout>
                <Button Grid.Column="3" Text="⋮" FontSize="23" TextColor="#1E3A5F" BackgroundColor="Transparent" Padding="0" Clicked="OnConversationMenuClicked"/>
            </Grid>
        </Border>

        <ScrollView x:Name="MessagesScroll" Grid.Row="1">
            <VerticalStackLayout x:Name="MessagesHost" Padding="12,14" Spacing="7"/>
        </ScrollView>

        <Grid Grid.Row="2" Padding="9,7,9,10" ColumnDefinitions="*,48" ColumnSpacing="7" BackgroundColor="#F7F9FC">
            <Border Padding="13,1" BackgroundColor="White" Stroke="#D6DEE7">
                <Border.StrokeShape><RoundRectangle CornerRadius="22"/></Border.StrokeShape>
                <Entry x:Name="MessageEntry" Placeholder="Mensagem" FontSize="14" ReturnType="Send" Completed="OnMessageCompleted"/>
            </Border>
            <Button Grid.Column="1" Text="➤" FontSize="20" TextColor="White" BackgroundColor="#1E66C2" CornerRadius="24" Padding="0" WidthRequest="48" HeightRequest="48" Clicked="OnSendClicked"/>
        </Grid>
    </Grid>
</ContentPage>
