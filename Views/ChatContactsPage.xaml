<?xml version="1.0" encoding="utf-8" ?>
<ContentPage x:Class="NajGravador.Views.ChatContactsPage" xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" BackgroundColor="#F7F9FC" Shell.NavBarIsVisible="False">
    <Grid RowDefinitions="Auto,Auto,*">
        <Border Padding="12,10" BackgroundColor="White" Stroke="#E2E7ED"><Grid ColumnDefinitions="44,*"><Button Text="‹" FontSize="30" TextColor="#1E3A5F" BackgroundColor="Transparent" Padding="0" Clicked="OnBackClicked"/><VerticalStackLayout Grid.Column="1" Spacing="0" VerticalOptions="Center"><Label Text="Nova conversa" FontSize="19" FontAttributes="Bold" TextColor="#1E3A5F"/><Label x:Name="ContactCountLabel" FontSize="10" TextColor="#768493"/></VerticalStackLayout></Grid></Border>
        <Border Grid.Row="1" Margin="14,12,14,7" Padding="10,0" BackgroundColor="White" Stroke="#DCE3EB"><Border.StrokeShape><RoundRectangle CornerRadius="19"/></Border.StrokeShape><SearchBar x:Name="ContactSearchBar" Placeholder="Buscar contatos salvos" FontSize="13" TextColor="#26384A" PlaceholderColor="#7A8795" SearchIconColor="#4A5568" BackgroundColor="Transparent" TextChanged="OnSearchChanged"/></Border>
        <ScrollView Grid.Row="2"><VerticalStackLayout Padding="14,6,14,30" Spacing="7">
            <Border Padding="10" BackgroundColor="White" Stroke="#E1E6EC"><Border.StrokeShape><RoundRectangle CornerRadius="12"/></Border.StrokeShape><Border.GestureRecognizers><TapGestureRecognizer Tapped="OnNewGroupTapped"/></Border.GestureRecognizers><Grid ColumnDefinitions="52,*" ColumnSpacing="10"><Image Source="default_group.svg" WidthRequest="43" HeightRequest="43"/><Label Grid.Column="1" Text="Novo grupo" FontSize="15" FontAttributes="Bold" TextColor="#24394F" VerticalTextAlignment="Center"/></Grid></Border>
            <Border Padding="10" BackgroundColor="White" Stroke="#E1E6EC"><Border.StrokeShape><RoundRectangle CornerRadius="12"/></Border.StrokeShape><Border.GestureRecognizers><TapGestureRecognizer Tapped="OnNewContactTapped"/></Border.GestureRecognizers><Grid ColumnDefinitions="52,*" ColumnSpacing="10"><Grid WidthRequest="43" HeightRequest="43"><Image Source="default_avatar.svg" Margin="8"/><Border WidthRequest="18" HeightRequest="18" Padding="0" BackgroundColor="#1E66C2" Stroke="White" HorizontalOptions="End" VerticalOptions="End"><Border.StrokeShape><RoundRectangle CornerRadius="9"/></Border.StrokeShape><Label Text="+" FontSize="13" FontAttributes="Bold" TextColor="White" HorizontalTextAlignment="Center" VerticalTextAlignment="Center"/></Border></Grid><Label Grid.Column="1" Text="Novo contato" FontSize="15" FontAttributes="Bold" TextColor="#24394F" VerticalTextAlignment="Center"/></Grid></Border>
            <Label Text="Contatos salvos" FontSize="12" FontAttributes="Bold" TextColor="#657487" Margin="4,12,0,2"/>
            <VerticalStackLayout x:Name="ContactsHost" Spacing="5"/>
            <Label x:Name="NoContactsLabel" Text="Nenhum contato salvo!" IsVisible="False" FontSize="14" TextColor="#788695" HorizontalTextAlignment="Center" Margin="20,35"/>
        </VerticalStackLayout></ScrollView>
    </Grid>
</ContentPage>
